{
  "name": "agent-tournament",
  "version": "0.1.0",
  "description": "Evolutionary tournaments for LLM agents: blind judging, selection and mutation across rounds, sealed evidence, and Docker-isolated execution.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BestMiraPro/Agent-tournament.git"
  },
  "keywords": [
    "llm",
    "agents",
    "evaluation",
    "llm-as-judge",
    "evolutionary-algorithms",
    "sandbox",
    "docker",
    "fastify",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite build --logLevel warn && tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tournament": "tsx src/cli.ts",
    "dashboard": "tsx src/server/index.ts",
    "web:dev": "vite",
    "web:build": "vite build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  }
}
