# This repo lives on a Windows mount but is authored with LF.
# Without this, every checkout re-CRLFs the tree and `git status` shows
# ~66 files modified with zero real content changes -- noise that has
# already caused one worker to clobber a commit.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# Windows batch files are the exception: cmd.exe mis-parses labels and goto in
# LF-only files, so the double-click launcher must be checked out with CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
